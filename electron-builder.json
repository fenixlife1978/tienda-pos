{
  "appId": "com.lagranbodega.distribuidora",
  "productName": "Distribuidora La Gran Bodega M&S",
  "directories": {
    "output": "release-builds"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/icons/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icons/TiendaPOS.ico"
  },
  "portable": {
    "artifactName": "Distribuidora-Demo-Portable.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Distribuidora La Gran Bodega ERP",
    "artifactName": "Distribuidora-Setup-Installer.exe",
    "installerIcon": "build/icons/TiendaPOS.ico",
    "uninstallerIcon": "build/icons/TiendaPOS.ico"
  }
}